APP_NAME="Plant Growth Academy"
APP_ENV=production
APP_KEY=base64:replace-with-php-artisan-key-generate-show
APP_DEBUG=false
APP_URL=https://your-api.up.railway.app
FRANKENPHP_CONFIG="php_ini max_file_uploads 101"

FRONTEND_URL=https://your-project.vercel.app
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

JWT_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_TTL_DAYS=7

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

# Copy the Session pooler values from Supabase Dashboard > Connect.
DB_CONNECTION=pgsql
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=replace-with-your-supabase-database-password
DB_SEARCH_PATH=public
DB_SSLMODE=require
DB_PERSISTENT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
CACHE_PREFIX=plant_growth_academy
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Durable user uploads. Create a PUBLIC bucket named plant-media first.
MEDIA_DRIVER=supabase
MEDIA_DISK=public
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-only-supabase-secret-key
SUPABASE_STORAGE_BUCKET=plant-media
SUPABASE_STORAGE_TIMEOUT=30

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=replace-with-your-16-character-google-app-password
MAIL_FROM_ADDRESS=${MAIL_USERNAME}
MAIL_FROM_NAME="Plant Growth Academy"
MAIL_TIMEOUT=10

PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://your-api.up.railway.app/api/auth/google/callback
GOOGLE_OAUTH_TIMEOUT=10

ADMIN_USERNAME=academy_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
