APP_NAME="Plant Growth Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-service-name.onrender.com
ASSET_URL=https://your-service-name.onrender.com

FRONTEND_URL=https://project-end-teal.vercel.app
CORS_ALLOWED_ORIGINS=https://project-end-teal.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

JWT_SECRET=
JWT_TTL_DAYS=7

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

# Supabase Session Pooler values (Dashboard > Connect).
DB_CONNECTION=pgsql
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SEARCH_PATH=public
DB_SSLMODE=require
DB_PERSISTENT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
CACHE_PREFIX=plant_growth_academy
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

PUBLIC_CATALOG_CACHE_STORE=file
PUBLIC_CATALOG_CACHE_SECONDS=300
PUBLIC_CATALOG_BROWSER_CACHE_SECONDS=30

MEDIA_DRIVER=supabase
MEDIA_DISK=public
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=plant-media
SUPABASE_STORAGE_TIMEOUT=30

# Google is the only sign-in method.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-service-name.onrender.com/api/auth/google/callback
GOOGLE_OAUTH_TIMEOUT=10

MAIL_MAILER=log
RUN_MIGRATIONS=true

EXTERNAL_HTTP_VERIFY_SSL=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="PlantGrowthAcademy/1.0 (contact: admin@your-domain.com)"

ADMIN_USERNAME=academy_admin
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=
