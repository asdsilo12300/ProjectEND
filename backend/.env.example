APP_NAME=Laravel
APP_ENV=local
APP_KEY=
JWT_SECRET=local-dev-jwt-secret-change-me-at-least-32-characters-long
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_URL=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_SEARCH_PATH=public
# DB_SSLMODE=prefer
# DB_SSLROOTCERT=
# DB_PERSISTENT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
MEDIA_DRIVER=laravel
MEDIA_DISK=public
PRIVATE_MEDIA_DRIVER=laravel
PRIVATE_MEDIA_DISK=local
SUPABASE_PRIVATE_BUCKET=issue-evidence
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Google is the only sign-in method. Keep the client secret on the backend only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_OAUTH_TIMEOUT=10
FRONTEND_URL=http://localhost:5173

# Admin read models use a short local cache so remote PostgreSQL latency does
# not block the administration console on every background refresh.
ADMIN_DASHBOARD_CACHE_STORE=file
ADMIN_DASHBOARD_CACHE_SECONDS=30
ADMIN_LOOKUP_CACHE_SECONDS=300
ADMIN_USER_CACHE_SECONDS=15

# Local bootstrap administrator. Change these before seeding a production database.
ADMIN_USERNAME=academy_admin
ADMIN_EMAIL=admin@plantgrowth.local
ADMIN_PASSWORD=change-this-before-production

# Outbound HTTPS used by OpenStreetMap/Nominatim and Open-Meteo. Most Linux
# hosts use the operating-system CA store automatically. On Windows, the app
# also discovers Git for Windows' CA bundle. Set an explicit absolute path if
# PHP cannot find a trusted CA bundle on your machine.
EXTERNAL_HTTP_VERIFY_SSL=true
EXTERNAL_HTTP_CA_BUNDLE=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="PlantGrowthAcademy/1.0"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

