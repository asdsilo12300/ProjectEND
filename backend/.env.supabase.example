APP_NAME="Plant Growth Academy"
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
# Generate a separate random secret of at least 32 characters.
JWT_SECRET=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://www.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Copy the Session pooler values from Supabase Dashboard > Connect.
# Session mode (normally port 5432) is suitable for Laravel and migrations.
DB_CONNECTION=pgsql
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD="replace-with-your-supabase-database-password"
DB_SEARCH_PATH=public
DB_SSLMODE=require
# For certificate + hostname verification, download the Supabase CA certificate,
# change DB_SSLMODE to verify-full, then set its absolute path here.
# DB_SSLROOTCERT=C:/secure/path/prod-ca-2021.crt

# DB_URL can be used instead of the individual DB_* connection fields.
# Percent-encode special characters in the URL password before enabling it.
# DB_URL=postgresql://postgres.your-project-ref:encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Keep sync until a jobs-table migration or another queue backend is configured.
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=plant_growth_academy

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="Plant Growth Academy"
MAIL_TIMEOUT=10

PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback
GOOGLE_OAUTH_TIMEOUT=10

# Only used when intentionally running the production seeders.
ADMIN_USERNAME=academy_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
